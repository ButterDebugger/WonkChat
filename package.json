{
	"name": "wonkchat",
	"private": true,
	"version": "1.3.0",
	"description": "A simplistic and purely anonymous chat app",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"bun run dev:build\" \"bun run dev:serve\"",
		"dev:build": "bunx vite build --emptyOutDir --mode development --watch",
		"dev:serve": "bun run --hot src/server.ts",
		"build": "bunx vite build --emptyOutDir",
		"serve": "bun run src/server.ts",
		"start": "bunx vite build --emptyOutDir && bun run src/server.ts"
	},
	"dependencies": {
		"@debutter/trufflebyte": "npm:@jsr/debutter__trufflebyte@1.4.1",
		"@hono/zod-openapi": "^0.19.9",
		"@libsql/kysely-libsql": "^0.4.1",
		"@scalar/hono-api-reference": "^0.8.10",
		"bcrypt": "^5.1.1",
		"chalk": "^5.4.1",
		"hono": "^4.8.3",
		"hono-rate-limiter": "^0.4.2",
		"jose": "^6.0.10",
		"kysely": "^0.27.6",
		"openpgp": "^6.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.1",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/bun": "^1.2.9",
		"@types/node": "^22.14.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"bun-types": "latest",
		"concurrently": "^10.0.4",
		"vite": "^8.1.5"
	}
}
